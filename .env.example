# Super admin — isi dengan users.id dari database
# Superadmin dapat menjalankan .assist untuk manage fitur per grup
SUPER_ADMIN_USER_ID=

# AI (gunakan Ollama atau OpenAI-compatible API)
# Aktifkan fitur AI
AI_ENABLED=false
# Provider: ollama, openai, atau custom OpenAI-compatible
AI_PROVIDER=ollama
# Model name (contoh: llama3.2, gpt-4o-mini, gemini-2.5-flash, gemma3)
AI_MODEL=llama3.2
# Base URL API — default Ollama: http://localhost:11434/v1
AI_API_URL=http://localhost:11434/v1
# API key — kosongkan untuk Ollama (tidak perlu auth)
AI_API_KEY=

# Telegram notifier — kirim alert + QR code saat bot perlu re-scan
# Setup: chat @BotFather -> /newbot -> dapat token. Chat bot baru itu, lalu
# curl "https://api.telegram.org/bot<TOKEN>/getUpdates" -> ambil chat.id.
# Kosongkan keduanya untuk disable (bot tetap jalan, alert cuma di log lokal).
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
