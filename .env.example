# Supervisor admin — isi dengan users.id dari database
# Superadmin auto-approve grup yang belum terdaftar di whitelist
SUPER_ADMIN_USER_ID=
# Aktifkan whitelist group (hanya grup terdaftar yang bisa pakai bot)
# Hanya berfungsi jika SUPER_ADMIN_USER_ID terisi
WHITELIST_ENABLED=false

# AI (gunakan Ollama atau OpenAI-compatible API)
# Aktifkan fitur AI
AI_ENABLED=false
# Provider: ollama, openai, atau custom OpenAI-compatible
AI_PROVIDER=ollama
# Model name (contoh: llama3.2, gpt-4o-mini, gemma3)
AI_MODEL=llama3.2
# Base URL API — default Ollama: http://localhost:11434/v1
AI_API_URL=http://localhost:11434/v1
# API key — kosongkan untuk Ollama (tidak perlu auth)
AI_API_KEY=
# Maksimal rows per table yang dikirim ke AI sebagai context
# Kosongkan untuk tanpa batas
AI_CONTEXT_MAX_ROWS=
